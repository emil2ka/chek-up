# Скопируй этот файл в .env.local. Все переменные необязательны: без них сервер работает локально —
# БД встроенная (PGlite, папка .data/), а чеки распознаются в демо-режиме. Секреты — только на сервере, в браузер и в git не попадают.

# ── База данных ──
# Не задана → встроенный Postgres PGlite в .data/pglite (миграции применяются сами).
# Задана → обычный Postgres (Supabase, Neon, свой сервер). Таблицы создаёт `pnpm db:migrate`.
DATABASE_URL=
# Где лежат файлы PGlite (по умолчанию .data/pglite)
PGLITE_DIR=

# ── Распознавание чеков ──
# Впиши ОДИН ключ — провайдер определится сам. Без ключей приложение показывает пример и честно об этом пишет.
# Сравнение моделей и цены — docs/recognition-research.md

# OpenRouter (по умолчанию модель z-ai/glm-5.3-flash — проверена на тестовом чеке). Ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Google Gemini gemini-3.5-flash-lite: бесплатный уровень без карты. Ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenAI gpt-6-luna: самый дешёвый платный, предоплата от $5. Ключ: https://platform.openai.com/api-keys
OPENAI_API_KEY=
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=

# Необязательно: если ключей несколько, какой провайдер использовать (gemini | openai | mistral | anthropic | openrouter)
# Без этой строки берётся первый по порядку: gemini → openai → mistral → anthropic → openrouter
SCAN_PROVIDER=

# Необязательно: другие модели вместо стандартных (см. DEFAULT_MODELS в src/lib/scan/config.ts)
# Шаг 1: фото → позиции чека
SCAN_VISION_MODEL=
# Шаг 2: позиции → сахар, «вредное», замены
SCAN_TEXT_MODEL=
